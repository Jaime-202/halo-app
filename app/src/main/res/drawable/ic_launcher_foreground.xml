<?xml version="1.0" encoding="utf-8"?>
<!-- Halo: anillo de progreso (3/4) con degradado Ion → Flux y punto de inicio.
     Todo dentro de la zona segura de 66dp del icono adaptativo. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pista del anillo -->
    <path
        android:pathData="M54,28 A26,26 0 1,1 53.99,28"
        android:strokeWidth="7"
        android:strokeColor="#1B222B"
        android:fillColor="#00000000" />

    <!-- Progreso: 3/4 de vuelta en sentido horario desde arriba -->
    <path
        android:pathData="M54,28 A26,26 0 1,1 28,54"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="28"
                android:endX="28"
                android:endY="80"
                android:startColor="#7CF5D8"
                android:endColor="#8AA7FF" />
        </aapt:attr>
    </path>

    <!-- Punto de inicio -->
    <path
        android:pathData="M54,24 A4,4 0 1,1 53.99,24 Z"
        android:fillColor="#E9EEF2" />
</vector>
